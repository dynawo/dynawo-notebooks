{
    "_documentation": {
        "purpose": "Registry of the Dynawo Modelica models supported by the PyPowSyBl workflow. Each entry, keyed by the fully qualified Modelica class, tells how the component enters the load flow and which Dynawo model of the model database represents it in the dynamic simulation.",
        "element": "Static network element created for the component: bus, line, transformer, generator, load or shunt.",
        "power_flow": "Modelica parameters defining the load flow behaviour. p/q are in pu (base SnRef) with the given convention, u/angle are the voltage magnitude (pu) and angle (rad). Expressions may combine parameters of the component. 'slack' marks infinite buses, 'voltage_control' false forces a PQ injection.",
        "dynawo.category": "PyPowSyBl dynamic mapping category (see ModelMapping.get_categories_names()).",
        "dynawo.lib": "Name of the model in the Dynawo model database (ddb).",
        "dynawo.prefix": "Prefix of the parameters and variables of the Dynawo model.",
        "dynawo.initial_values": "Dynawo parameters taken from the solved load flow. Available quantities: p_pu/q_pu (receptor convention), p_gen_pu/q_gen_pu (generator convention), u_pu, angle_rad, u_nom_kv, and the complex u0/s0/i0 (receptor convention) through their re and im parts.",
        "dynawo.parameters": "Dynawo parameters computed from the Modelica parameters of the component when their names or units differ. Any other Dynawo parameter takes the value of the Modelica parameter with the same name.",
        "dynawo.additional_model": "Registration of a Dynawo model that PyPowSyBl does not ship, written to the additionalModelsFile of the simulation.",
        "dynawo.minimum_magnitude": "Dynawo parameters whose absolute value is raised to a minimum to keep the Dynawo solver well conditioned.",
        "dynawo.modelica_model": "Modelica class compiled into the Dynawo model (preassembled model definition of the model database), when it is not the class of the entry itself. Defaults to the class of the entry.",
        "dynawo.init_model": "Initialization model (initName) compiled with the Dynawo model, which computes its initial state from the load flow. Omitted when the model has none.",
        "categories": "Key of each PyPowSyBl dynamic model category in the PyPowSyBl model configuration (models.json), under which the models compiled for a case are registered as additional models."
    },
