<?xml version="1.0" encoding="UTF-8"?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">

    <set id="GenPV">
        <par type="DOUBLE" name="generator_DPu" value="0.0"/>
        <par type="INT" name="generator_ExcitationPu" value="0"/>
        <par type="DOUBLE" name="generator_H" value="3.2"/>
        <par type="DOUBLE" name="generator_MdPuEfd" value="0.0"/>
        <par type="INT" name="generator_NbSwitchOffSignals" value="3"/>
        <par type="DOUBLE" name="generator_P0Pu" value="0.0"/>
        <par type="DOUBLE" name="generator_PNomAlt" value="1000.0"/>
        <par type="DOUBLE" name="generator_PNomTurb" value="1000.0"/>
        <par type="DOUBLE" name="generator_Q0Pu" value="0.0"/>
        <par type="DOUBLE" name="generator_RTfPu" value="0.0"/>
        <par type="DOUBLE" name="generator_RaPu" value="0.0025"/>
        <par type="DOUBLE" name="generator_SNom" value="1000.0"/>
        <par type="DOUBLE" name="generator_SnTfo" value="1000.0"/>
        <par type="INT" name="generator_State0" value="2"/>
        <par type="BOOL" name="generator_SwitchOffSignal10" value="false"/>
        <par type="BOOL" name="generator_SwitchOffSignal20" value="false"/>
        <par type="BOOL" name="generator_SwitchOffSignal30" value="false"/>
        <par type="DOUBLE" name="generator_Tpd0" value="8.0"/>
        <par type="DOUBLE" name="generator_Tppd0" value="0.03"/>
        <par type="DOUBLE" name="generator_Tppq0" value="0.05"/>
        <par type="DOUBLE" name="generator_Tpq0" value="0.4"/>
