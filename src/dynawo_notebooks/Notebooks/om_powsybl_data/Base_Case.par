        <par type="DOUBLE" name="generator_UNomLV" value="20.0"/>
        <par type="DOUBLE" name="generator_UPhase0" value="0.0"/>
        <par type="BOOL" name="generator_UseApproximation" value="false"/>
        <par type="DOUBLE" name="generator_XTfPu" value="0.0"/>
        <par type="DOUBLE" name="generator_XdPu" value="1.8"/>
        <par type="DOUBLE" name="generator_XlPu" value="0.15"/>
        <par type="DOUBLE" name="generator_XpdPu" value="0.3"/>
        <par type="DOUBLE" name="generator_XppdPu" value="0.25"/>
        <par type="DOUBLE" name="generator_XppqPu" value="0.25"/>
        <par type="DOUBLE" name="generator_XpqPu" value="0.55"/>
        <par type="DOUBLE" name="generator_XqPu" value="1.7"/>
